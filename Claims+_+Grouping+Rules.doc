nceTd">
<p local-id=3D"38f71cc02075">Coupe=E2=80=99s internal employerID, used for =
employer-specific rules</p></td>
<td data-local-id=3D"8dca6b96-44df-48f4-a175-f1ccd8c761f2" class=3D"conflue=
nceTd">
<p local-id=3D"a824056eb8ed">&nbsp;</p></td>
</tr>
<tr data-local-id=3D"37347bec-d464-4de8-930b-de92be37e3a4">
<td data-local-id=3D"95436755-8e6b-422a-98b6-a0e98a3b4d3f" class=3D"conflue=
