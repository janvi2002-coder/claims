nceTd">
<p local-id=3D"a5f9dc3857a7">Telehealth</p></td>
<td data-local-id=3D"b2d39ca1-a859-4060-9076-c49be0dceac5" class=3D"conflue=
nceTd">
<p local-id=3D"e4a527dce16e">POS + Modifier</p></td>
</tr>
<tr data-local-id=3D"5b452aef-9735-44e7-9d35-a392673a7887">
<td data-local-id=3D"f692c0c0-f08a-46d4-8c98-804178ba784f" class=3D"conflue=
nceTd">
<p local-id=3D"5da5f5de2f0d">Maternity</p></td>
<td data-local-id=3D"d650a317-8a6a-48e4-98e8-54d97e731295" class=3D"conflue=
nceTd">
<p local-id=3D"9c2e19b563d1">DRG + CPT Buckets</p></td>
</tr>
<tr data-local-id=3D"484bb19e-92cf-4b20-9a7f-93e32f54a34b">
<td data-local-id=3D"849970f4-f475-4716-8984-fc51973827f1" class=3D"conflue=
nceTd">
<p local-id=3D"a7a1b6461b73">Emergency/Urgent Care</p></td>
<td data-local-id=3D"4880fa91-13e5-4721-9919-f82788553024" class=3D"conflue=
nceTd">
<p local-id=3D"328050f2dd69">POS + Revenue Codes</p></td>
</tr>
<tr data-local-id=3D"33b043b1-903d-4ab2-901a-d5480963eb58">
<td data-local-id=3D"8120f932-0cba-4676-8f0c-8c1e3150cd22" class=3D"conflue=
nceTd">
<p local-id=3D"064e1d4a0043">Default Catch-all Rules</p></td>
<td data-local-id=3D"a8f5504d-effb-45ef-86ac-2f2974262bcf" class=3D"conflue=
nceTd">
<p local-id=3D"21b505b83c41">PCP, Specialist, General Services</p></td>
</tr>
</tbody>
</table>
</div>
<p local-id=3D"69cb345af80b">Many rules repeat the same filters over and ov=
er:</p>
<p local-id=3D"3a6965d5a5bd">Example:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">POS =3D=
 131-149...
BillType =3D Surgery Center|Hospital
CPT Specialty Bucket =3D Cardiology
</pre>
</div>
</div>
<p local-id=3D"3e0e29b80b73">then</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">POS =3D=
 131-149...
BillType =3D Surgery Center|Hospital
CPT Specialty Bucket =3D Colorectal
</pre>
</div>
</div>
<p local-id=3D"ac39aacbc40c">then</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">POS =3D=
 131-149...
BillType =3D Surgery Center|Hospital
CPT Specialty Bucket =3D Spine Surgery
</pre>
</div>
</div>
<p local-id=3D"724edbed6400">Only the specialty bucket changes. <a href=3D"=
https://linkmn-my.sharepoint.com/personal/gary_sole_bluecrossmn_com/_layout=
s/15/Doc.aspx?sourcedoc=3D%7B8993138A-3E36-4F82-ACC5-9CFCFE481413%7D&amp;fi=
le=3DStage_RulesProcess_20260526143200.csv&amp;action=3Ddefault&amp;mobiler=
edirect=3Dtrue" class=3D"external-link" rel=3D"nofollow">[Stage_Rule...0526=
143200 | Excel]</a></p>
<p local-id=3D"d2558bb4d0bb">That is a sign that these should become a <str=
ong>lookup table</strong>, not individual rules.</p>
<hr local-id=3D"9085b095-9540-4d11-b870-ae0ca73c8950">
<h1 local-id=3D"1a9bd054746b" id=3D"Claims/GroupingRules-NectedArchitecture=
Recommendation">Nected Architecture Recommendation</h1>
<p local-id=3D"7996cbd15827">Instead of 730 sequential rules, build a Flow =
that progressively narrows the universe.</p>
<h2 local-id=3D"e61e6b5ffa59" id=3D"Claims/GroupingRules-Node1-ClaimOverrid=
es">Node 1 - Claim Overrides</h2>
<p local-id=3D"58b042fcc194">Evaluate a very small set first.</p>
<p local-id=3D"dfef6837194c">Examples:</p>
<ul local-id=3D"109f111b-b816-48a6-b2de-ca7256695790">
<li local-id=3D"ebea26a7-47e4-4ac1-aa4f-bb10f577c259">
<p local-id=3D"4666a6c19499">Covid</p></li>
<li local-id=3D"e4e11b99-1ee4-4a50-a2fc-d4e6116826d7">
<p local-id=3D"1ed522d31213">Employer-specific rules</p></li>
<li local-id=3D"6a5164b9-a891-4c7b-a4f9-9e524f310ed0">
<p local-id=3D"ed39ab8390db">Special HSB claims</p></li>
<li local-id=3D"1dec143b-37a6-4e6a-9e12-59dd649a5724">
<p local-id=3D"06b67a5b999e">Autism programs</p></li>
<li local-id=3D"fd85504c-bdda-4b9b-a60d-9d9428b17ba5">
<p local-id=3D"a794e8b3f049">Special telehealth employers</p></li>
</ul>
<p local-id=3D"a61791247399">These are highest-ranked exceptions already. <=
a href=3D"https://linkmn-my.sharepoint.com/personal/gary_sole_bluecrossmn_c=
om/_layouts/15/Doc.aspx?sourcedoc=3D%7B8993138A-3E36-4F82-ACC5-9CFCFE481413=
%7D&amp;file=3DStage_RulesProcess_20260526143200.csv&amp;action=3Ddefault&a=
mp;mobileredirect=3Dtrue" class=3D"external-link" rel=3D"nofollow">[Stage_R=
ule...0526143200 | Excel]</a></p>
<p local-id=3D"d1e0230e9d24">Result:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">Overrid=
e Benefit Code found?
YES -&gt; return
NO -&gt; continue
</pre>
</div>
</div>
<p local-id=3D"7cb0e367324b">This node may only contain 20-30 rules.</p>
<hr local-id=3D"6160b0d9-b18f-4a44-a7a7-f0ddef5287dc">
<h2 local-id=3D"d500886bbff0" id=3D"Claims/GroupingRules-Node2-DetermineCla=
imContext">Node 2 - Determine Claim Context</h2>
<p local-id=3D"7eef311fe2fc">Create a decision table that derives:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">{
  "careSetting": "INPATIENT|OUTPATIENT|PROFESSIONAL|FACILITY"
}</pre>
</div>
</div>
<p local-id=3D"2aacb79bf7e9">using:</p>
<ul local-id=3D"3b55b6eb-3f16-4f2f-be22-81c24b23d41f">
<li local-id=3D"cdb67939-fb84-40e3-a6b7-e36add164e19">
<p local-id=3D"103f4854dc62">POS</p></li>
<li local-id=3D"28439994-5720-4c43-a1a3-f96cab7330a6">
<p local-id=3D"fdd7cc13fd2d">BillType</p></li>
<li local-id=3D"22028901-794e-46f1-b049-7daea9ede174">
<p local-id=3D"8acd45f9ab2d">ClaimType</p></li>
</ul>
<p local-id=3D"8dc89595145a">instead of repeatedly testing those values lat=
er.</p>
<p local-id=3D"0305b9040567">Example:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">POS 111=
-119
=3D&gt; INPATIENT
</pre>
</div>
</div>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">POS 131=
-149
=3D&gt; OUTPATIENT_FACILITY
</pre>
</div>
</div>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">ClaimTy=
pe=3DP
=3D&gt; PROFESSIONAL
</pre>
</div>
</div>
<p local-id=3D"d302b73ec594">This immediately eliminates 70-80% of later ru=
les.</p>
<hr local-id=3D"96d107b1-493f-45a5-8f52-5524e9c0d32e">
<h2 local-id=3D"8b1cee37ce8a" id=3D"Claims/GroupingRules-Node3-DeriveServic=
eCategories">Node 3 - Derive Service Categories</h2>
<p local-id=3D"12f826847839">Create reusable enrichment attributes.</p>
<h3 local-id=3D"ee53c0235353" id=3D"Claims/GroupingRules-FacilityCategory">=
FacilityCategory</h3>
<p local-id=3D"c83fd27e5fc4">Examples:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">Hospita=
l
ASC
SNF
Behavioral Health Facility
Imaging Center
Dialysis Center
</pre>
</div>
</div>
<p local-id=3D"dbde4e82381e">Currently this logic is embedded in hundreds o=
f rules. <a href=3D"https://linkmn-my.sharepoint.com/personal/gary_sole_blu=
ecrossmn_com/_layouts/15/Doc.aspx?sourcedoc=3D%7B8993138A-3E36-4F82-ACC5-9C=
FCFE481413%7D&amp;file=3DStage_RulesProcess_20260526143200.csv&amp;action=
=3Ddefault&amp;mobileredirect=3Dtrue" class=3D"external-link" rel=3D"nofoll=
ow">[Stage_Rule...0526143200 | Excel]</a></p>
<hr local-id=3D"89470d82-b2e2-42d6-a0fa-ec6c2c359a6b">
<h3 local-id=3D"5217e3434f6f" id=3D"Claims/GroupingRules-ProviderCategory">=
ProviderCategory</h3>
<p local-id=3D"f056fdc43951">Examples:</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">PCP
Specialist
MentalHealth
Therapist
Lab
Radiology
DME
</pre>
</div>
</div>
<p local-id=3D"7faa19c1fe58">Derived from:</p>
<ul local-id=3D"d33ff014-d909-4a3a-aa13-10d18a682702">
<li local-id=3D"2235a648-129a-4977-ba2c-f483e1d12205">
<p local-id=3D"2eeddf254e92">SpecialtyID</p></li>
<li local-id=3D"5fc1794f-0e6d-4a8b-8a43-2a0c770237de">
<p local-id=3D"7d60119eabbe">TaxonomySpecialty</p></li>
</ul>
