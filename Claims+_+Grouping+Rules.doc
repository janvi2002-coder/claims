</tr>
<tr data-local-id=3D"33f7ef9d-a014-43f7-996f-71a733db1e2a">
<td data-local-id=3D"a82d336c-265a-4791-8059-cd1ba6570efc" class=3D"conflue=
nceTd">
<p local-id=3D"dfd59f50a4be">Imaging</p></td>
<td data-local-id=3D"86f27894-31c3-492d-b60a-ba3d72e98314" class=3D"conflue=
nceTd">
<p local-id=3D"b5421bb1daec">CPT Buckets</p></td>
</tr>
<tr data-local-id=3D"f79e5438-f595-4c3f-9d26-cb2930746551">
<td data-local-id=3D"7dc24e5e-0076-447d-a10c-06b874b01ef5" class=3D"conflue=
nceTd">
<p local-id=3D"b5d573f97ca2">Laboratory</p></td>
<td data-local-id=3D"a149199e-66bf-4d53-93a2-c69c39f5d3c5" class=3D"conflue=
